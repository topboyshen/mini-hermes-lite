# Telegram（必填）
TELEGRAM_TOKEN=
# 留空时，Bot 只允许 /start 和 /whoami，用返回的 ID 填入这里后重启。
TELEGRAM_ALLOWED_USER_IDS=

# 模型（选择一种提供商并填写对应 Key）
MODEL=openai:gpt-5-mini
# 可选：为每日晨报指定独立模型；留空则使用 MODEL。
REPORT_MODEL=
OPENAI_API_KEY=
OPENAI_BASE_URL=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=

# Mini Hermes
APP_TIMEZONE=Asia/Shanghai
DAILY_REPORT_TIME=08:30
AGENT_TIMEOUT_SECONDS=120
MAX_HISTORY_MESSAGES=8
MAX_CONCURRENT_AGENT_RUNS=2

# pi 交互 channel
PI_CHANNEL_SOCKET=/run/mini-hermes-pi/pi.sock
PI_CHANNEL_TIMEOUT_SECONDS=600

# MCP
MCP_CONFIG=/opt/mini-hermes/config/mcp.json
AKSHARE_MAX_ROWS=200
QUANTERS_USE_AKTOOLS=false

# 路径
DATA_DIR=/opt/mini-hermes/data
LOG_DIR=/var/log/mini-hermes
